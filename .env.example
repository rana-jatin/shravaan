# Sarvam credentials
SARVAM_API_KEY=

# --- Docker Compose ------------------------------------------------------------
# Read by docker-compose.yml itself, not by any application. Compose reads this
# directory's `.env` for ${...} substitution, which is why they live here rather
# than in a package's own file.
#
# POSTGRES_PASSWORD has NO DEFAULT and compose refuses to start without it. It
# used to be the literal `shravaan`, committed in docker-compose.yml and repeated
# inside DATABASE_URL — and a compose file is the thing most likely to be copied
# onto a server unchanged. Any value will do locally; generate a real one for
# anything that is not your laptop.
POSTGRES_PASSWORD=
# Optional. Both default to `shravaan` when unset — neither is a secret.
POSTGRES_USER=
POSTGRES_DB=

# --- Endpoint bases -----------------------------------------------------------
# NOTE: these paths come from Sarvam's guide pages. The API-reference pages that
# would confirm exact hostnames returned 404 during research (see
# docs/05-open-questions.md Q12). VERIFY against the dashboard before first run.
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_WS_BASE=wss://api.sarvam.ai

# --- Models -------------------------------------------------------------------
# saaras:v3-realtime is the ONLY model the realtime socket accepts.
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
# NOT `sarvam-105b` — that one is a reasoning model and streams ~5-8k chars of
# `reasoning_content` before its first spoken token: 12.8 s to first word against
# 313 ms here, plus empty completions under load. See src/config/env.ts.
SARVAM_LLM_MODEL=sarvam-105b-conversations

# --- Audio --------------------------------------------------------------------
# Sarvam realtime STT accepts ONLY 8000 or 16000. Bulbul streaming caps at 24000.
ASR_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000
# Read by the DEVICE CLIENT (scripts/device-client.ts), not by the server. The
# server used to load it into Config and never read it; that field is gone.
DEVICE_FRAME_MS=80

# --- Voice --------------------------------------------------------------------
TTS_SPEAKER=shubh
TTS_PACE=1.0

# --- Language -----------------------------------------------------------------
# Seed used when a user has no profile and no locale hint.
DEFAULT_SEED_LANGUAGE=hi-IN

# Fallback for the get_time tool when JSON context carries no identity.timezone.
# The model has no clock: a wrong zone here is a confidently wrong answer.
DEFAULT_TIMEZONE=Asia/Kolkata
# Auto-detect token. Sarvam's docs disagree: "auto" (realtime page) vs "unknown"
# (Saaras page) vs required-explicit (streaming guide). See docs/05 Q1.
# Slice 0 must confirm which of these the socket actually accepts.
ASR_AUTODETECT_TOKEN=auto

# --- Echo guard ---------------------------------------------------------------
# NOT a substitute for device-side AEC — the second layer that catches what leaks
# through. Defaults are deliberately conservative: a bot that occasionally misses
# an interruption is tolerable; one that interrupts itself is unusable. Tune
# toward sensitivity only once AEC is measured on real hardware.
# See docs/adr/0007-audio-front-end.md

# Ignore speech triggers for this long after playback starts.
ECHO_SUPPRESSION_MS=400
# Require a non-empty partial transcript before accepting barge-in, rather than
# acting on a bare VAD trigger.
ECHO_REQUIRE_TRANSCRIPT=true
# Token-overlap ratio above which an incoming partial is treated as our own voice
# echoing back. 0 disables correlation.
ECHO_SELF_THRESHOLD=0.6

# EMERGENCY FALLBACK ONLY. Mutes barge-in entirely while speaking. Removes the
# echo problem and removes interruption with it — a product downgrade, not a fix.
HALF_DUPLEX=false

# --- Working memory -----------------------------------------------------------
# Unset falls back to an in-process store: fine for single-instance development,
# useless across restarts or replicas. A store outage is survivable by design —
# the session continues stateless and marks itself degraded.
# Setting this also enables the Redis half of the store contract test suite.
REDIS_URL=

# --- Server -------------------------------------------------------------------
PORT=8080
# NOT IMPLEMENTED. Nothing reads this: log() in src/server.ts writes every line
# it is given. Kept documented rather than silently dropped, because setting it
# and getting no filtering is the kind of thing worth saying out loud.
# LOG_LEVEL=info

# --- Degradation (slice 8) ----------------------------------------------------
# See docs/adr/0008-degradation-policy.md

# ASR failover to Deepgram Flux. Covers hi-IN and en-IN ONLY; nine of our eleven
# languages have no second ASR at all.
#
# OFF BY DEFAULT, AND NOT BECAUSE OF THE COVERAGE GAP. Sarvam is India-resident by
# design; Deepgram publishes EU and AU endpoints and NO India region. Enabling this
# means a network blip can relocate a user's voice out of the country, mid
# conversation, as a side effect of incident response. That is a data-protection
# decision, not a default. See docs/05-open-questions.md Q14.
ASR_FAILOVER_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_WS_BASE=wss://api.deepgram.com
DEEPGRAM_ASR_MODEL=flux-general-multi

# --- Care signals (ADR 0009) --------------------------------------------------
# Retrospective wellbeing analysis of CLOSED sessions, via Deepgram's /v1/read
# Text Intelligence endpoint. Sentiment plus a fixed watch-list of care-relevant
# intents, attached to the episode the memory worker writes.
#
# NOTHING ON THE VOICE PATH CALLS THIS. The analysis runs in the memory worker,
# minutes to hours after the person stopped talking; the `recall_mood` tool reads
# what it wrote, from the local store. No turn ever waits on Deepgram.
#
# OFF BY DEFAULT, for three separate reasons and any one of them is enough:
#   1  RESIDENCY. Same call as ASR_FAILOVER_ENABLED above, one notch down: what
#      leaves India is a transcript rather than the voice itself. Still the
#      user's words. See docs/05-open-questions.md Q14.
#   2  COVERAGE. English only — every feature on that endpoint is. Ten of our
#      eleven languages are never analysed, and never will be.
#   3  CONSENT. Scoring how someone sounded, and keeping the trend, is a
#      different promise from remembering what they told you.
#
# Requires DEEPGRAM_API_KEY (shared with the ASR standby above). The server
# refuses to boot with this on and no key, rather than silently writing nothing.
CARE_SIGNALS_ENABLED=false
DEEPGRAM_READ_BASE=https://api.deepgram.com

# Hard cap on the analysis round trip. Nobody is waiting on it — but a wedged
# call becomes consumer lag, and lag is how long the companion has been out of
# date. Past this the episode is written without signals.
CARE_SIGNALS_DEADLINE_MS=8000

# Confidence floor for a watch-list intent.
# A GUESS: Deepgram publishes no calibration for confidence_score. Too low and a
# caregiver stops reading the digest; too high and it is silent. Tune against
# real transcripts — `npm run verify:care` prints what a sample scores.
CARE_SIGNALS_INTENT_CONFIDENCE=0.5

# Pre-rendered apology audio for a Bulbul outage — the one message that cannot be
# synthesised, because synthesis is what broke. Generate with:
#   npm run render:holding
# It needs a WORKING Bulbul, so it cannot be run during the outage it exists for.
# Relative to backend/'s cwd (where `npm run dev` launches the server from);
# the clips themselves live in ai/assets/holding.
HOLDING_AUDIO_DIR=../ai/assets/holding

# Bounded in-process buffer for mem:writes when the stream is unreachable. On
# overflow it drops the oldest LOW-PRIORITY event (a correction outranks a turn)
# and counts it. droppedCount is a product metric: the number of things the
# companion will never learn.
MEM_WRITE_BUFFER=500

# --- External tools -----------------------------------------------------------
# The only two tools that leave this process. Both OFF unless configured, and a
# tool that is not configured is never REGISTERED — so the model never sees it,
# never offers it, and never has to withdraw it.

# Weather, via Open-Meteo. No API key, no signup, no charge.
#
# The catch is residency, not cost: Open-Meteo is EU-hosted, so enabling this
# sends a place name out of India. That is far less than the ASR failover above
# (a city name, not the user's voice) but it is the same class of decision, so it
# is opt-in for the same reason. See docs/05-open-questions.md Q14.
WEATHER_ENABLED=false
WEATHER_API_BASE=https://api.open-meteo.com
WEATHER_GEOCODE_BASE=https://geocoding-api.open-meteo.com
# Used ONLY when the model asks for weather without naming a place. Leave unset
# and the companion asks which city — which beats guessing, because a confidently
# wrong city is indistinguishable from a correct answer to someone listening.
WEATHER_DEFAULT_PLACE=

# Country tried FIRST when geocoding, then abandoned if it finds nothing.
#
# NOT COSMETIC. Asked for "Allahabad", an unbiased Open-Meteo query returns ten
# Iranian villages and no Indian hit — a live call returned the weather for
# Razavi Khorasan, fluently, with nothing marking it wrong. It is a preference
# rather than a filter, so "London" still resolves to Britain on the retry.
# Blank disables it.
WEATHER_COUNTRY_BIAS=IN

# India Post, for six-digit PIN codes — Open-Meteo cannot geocode them at all.
# Blank disables pincode support and the companion asks for a place name.
# This host is in India, so the lookup most likely to be phrased as a number
# never leaves the country.
WEATHER_PINCODE_API=https://api.postalpincode.in

# News, via RSS. Configured as feed URLs rather than a vendor, so a deployment
# can point at a domestic outlet and keep the hop inside India.
#
# Format: category=url pairs, comma-separated. Known categories are
#   top, sports, business, world, entertainment
# Anything else is logged and ignored at boot. Only the categories you configure
# are offered to the model, so a half-filled list is safe.
#
# NO DEFAULT FEEDS SHIP. A wrong URL here is a companion reading out someone
# else's headlines with total confidence, and this repo cannot verify a feed it
# has never fetched. Paste the RSS URLs from your chosen outlet and check each
# one in a browser first.
#
#   NEWS_FEEDS=top=https://example.com/national.rss,sports=https://example.com/sport.rss
NEWS_FEEDS=

# ── Verified working 2026-08-30 (all returned 200 with parseable items) ───────
# Times of India
#   top     https://timesofindia.indiatimes.com/rssfeedstopstories.cms
#   sports  https://timesofindia.indiatimes.com/rssfeeds/4719148.cms
# The Hindu
#   top     https://www.thehindu.com/news/national/feeder/default.rss
#   sports  https://www.thehindu.com/sport/feeder/default.rss
# Indian Express
#   top     https://indianexpress.com/feed/
#   sports  https://indianexpress.com/section/sports/feed/
# NDTV
#   top     https://feeds.feedburner.com/ndtvnews-top-stories
#   sports  https://feeds.feedburner.com/ndtvsports-cricket
# Hindustan Times
#   top     https://www.hindustantimes.com/feeds/rss/india-news/rssfeed.xml
# Google News (India edition)
#   top     https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en
#
# SEPARATORS, verified: pairs split on "," and each pair on its FIRST "=", so
#   &  in a URL is safe   (?hl=en-IN&gl=IN parses intact — Google News works)
#   =  in a URL is safe   (only the first one separates key from value)
#   ,  in a URL IS NOT    (?ids=1,2,3 silently becomes ?ids=1)
# Percent-encode any literal comma as %2C. A truncated URL is refused at boot
# with an error naming the category, rather than 404-ing at request time.
# Headlines per answer. Small on purpose — these are read aloud, and a list of
# ten is a monologue nobody asked for.
NEWS_HEADLINE_LIMIT=5

# --- Music -------------------------------------------------------------------
# Two modes. `radio` streams a live station from the radio-browser directory;
# `song` searches the YouTube Data API for a specific track. Song mode is only
# offered when YOUTUBE_API_KEY is set — without it the tool's `mode` enum
# shrinks to ["radio"], so the model never offers what it cannot do.
MUSIC_ENABLED=false

# Community-edited directory. No key, no signup.
MUSIC_RADIO_API=https://de1.api.radio-browser.info
# Refreshed on a timer, NEVER inside a turn: a live lookup measured 4.4 s.
MUSIC_REFRESH_MINUTES=180
# Stations handed to the device per lookup. Stations rot; one is not enough.
MUSIC_STATIONS_PER_LANGUAGE=3
# Drop plain-http streams. About 15% of Indian stations are unencrypted.
MUSIC_SECURE_ONLY=true
# Offered — never taken silently — when a language has no stations at all.
# Gujarati has none in the directory. Empty means say so and stop.
MUSIC_FALLBACK_LANGUAGE=hi-IN

# YouTube Data API key. Search costs 100 of 10,000 free daily units, so about
# 100 searches a day: fine for a prototype, not for users.
YOUTUBE_API_KEY=
YOUTUBE_API_BASE=https://www.googleapis.com

# --- Playback and ducking -----------------------------------------------------
# Volume a stream starts at, 0-100.
MUSIC_VOLUME=70

# ⚠ THE ONE THAT KEEPS THE COMPANION ABLE TO HEAR YOU.
#
# Level the music drops to while ANYONE is speaking — the user, or the device
# itself. Without ducking, music at any real volume means the microphone hears
# the loudspeaker rather than the person: the ASR never reports speech and the
# companion appears to have stopped listening. Reported live at MUSIC_VOLUME=55,
# and the same problem made its replies inaudible underneath the song.
#
# Read by the DEVICE, not the server, and that is not an optimisation. The
# server only learns someone is speaking from the ASR, and the ASR is the thing
# that cannot hear over the music — so the trigger would never arrive at all.
# The device tracks the quiet baseline at the mic and ducks on the RISE above
# it, which is a far more sensitive test than "is this speech".
#
# Low, not zero: a stream that goes silent sounds broken, where one that drops
# under a voice sounds deliberate.
# Read by the DEVICE CLIENT, like DEVICE_FRAME_MS. The server has no ducking of
# its own — volume travels with the play_media request instead.
MUSIC_DUCK_VOLUME=15

# EMERGENCY BRAKE, not a default. Ignores everything except stop and volume
# while media plays. It removes the ASR transcribing song lyrics as user speech,
# and removes the ability to ask anything mid-song with it — a companion that
# stops listening the moment it starts entertaining you is not a companion.
MUSIC_RESTRICT_LISTENING=false

# DEVICE-SIDE. Turns a YouTube video id into a playable URL. Kept as a command
# string because how a device obtains that audio is exactly the decision that
# should stay swappable — an official embedded player, or a licensed source,
# replaces this one line.
#   MEDIA_RESOLVER=python -m yt_dlp -f bestaudio -g
MEDIA_RESOLVER=

# --- Calendar -----------------------------------------------------------------
# iCal feed URLs, NOT the Google Calendar API. The API needs OAuth per user, and
# an elderly user with a screenless device cannot complete a consent flow.
#
# In Google Calendar: Settings > Settings for my calendars > <calendar> >
# Integrate calendar > "Secret address in iCal format". Paste that URL here.
# Read-only, which is all the power a companion should have over someone's
# hospital appointments.
#
# Format: label=url pairs, comma-separated. The LABEL IS SPOKEN, so name it as a
# person would. Same comma caveat as NEWS_FEEDS — percent-encode as %2C.
#
#   CALENDAR_FEEDS=mine=https://calendar.google.com/calendar/ical/.../basic.ics
#
# Verified public feed, useful on its own for "when is Diwali?":
#   holidays=https://calendar.google.com/calendar/ical/en.indian%23holiday%40group.v.calendar.google.com/public/basic.ics
CALENDAR_FEEDS=
CALENDAR_EVENT_LIMIT=6

# --- Calendar, via the Google API ---------------------------------------------
# An UPGRADE over the iCal feed above, not a replacement — both can run at once,
# and a deployment with no Google project keeps working.
#
# Worth it mainly because `singleEvents=true` makes GOOGLE expand the
# recurrences. Our own RRULE expander had seven defects in it (docs/07 D10),
# every one of which spoke a wrong appointment aloud as fact. Google's handles
# BYSETPOS, BYMONTHDAY, RDATE and real TZID conversion; ours does not.
#
# label=calendarId pairs. A person's own calendar id is their email address.
# "primary" resolves only for a credential with a user identity — never a key.
GOOGLE_CALENDAR_IDS=

# ⚠ AN API KEY READS PUBLIC CALENDARS AND NOTHING ELSE.
#
# A key says which PROJECT is calling. It carries no user identity, so no OAuth
# scope — and Google requires a scope on every write method. Verified against
# their own discovery document:
#
#   events.list    GET     scopes: … calendar.readonly, calendar.events.public.readonly …
#   events.insert  POST    scopes: calendar, calendar.app.created, calendar.events, …
#   events.delete  DELETE  scopes: calendar, calendar.app.created, calendar.events, …
#
# There is no public-WRITE scope to match the public-read one. So with a key:
#   read a PUBLIC calendar ....... yes
#   read a PRIVATE calendar ...... no   (401/403, never partial)
#   write anything ............... no
#
# The server says this at boot rather than letting it surface as a 401 in the
# middle of a conversation.
GOOGLE_CALENDAR_API_KEY=

# THE credential for a private diary, and the only one that can write.
#
# Either inline JSON or a path to the file Google Cloud downloads. Setup a
# caregiver can actually complete, with no consent screen at any point:
#
#   1. Google Cloud console > IAM > Service Accounts > Create
#   2. Keys > Add key > JSON. Download it. Point this at the file.
#   3. Enable the Google Calendar API for that project.
#   4. In GOOGLE CALENDAR (not the console): Settings > your calendar >
#      "Share with specific people" > add the account's client_email, exactly as
#      you would share with a person.
#        - "See all event details"  -> read-only
#        - "Make changes to events" -> also enables add_appointment
#   5. Put that calendar's id in GOOGLE_CALENDAR_IDS.
#
# Works on a consumer Gmail calendar, not only Workspace. No refresh-token
# lifecycle: the server signs a JWT and exchanges it, in node:crypto, with no
# dependency in the path of a calendar credential.
#
# ⚠ This file is a private key. Keep it out of the repo; .env is gitignored.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Which calendar add_appointment WRITES to, by label. With one calendar
# configured this is optional. With several it is required: the write tool is
# not registered at all rather than guessing which diary a hospital appointment
# belongs in.
CALENDAR_WRITE_TARGET=

# NOTE: there is no cancel_appointment, deliberately. Creating a wrong entry is
# recoverable and gets read back aloud; deleting the right one is neither, and
# the user has no screen on which to notice it gone. See docs/05 Q15.

# --- Medication reminders -----------------------------------------------------
# THE FIRST THING IN THIS PRODUCT THAT SPEAKS WITHOUT BEING ASKED. A schedule
# comes due, the device waits for a gap in the conversation, says the reminder,
# says it again ten minutes later, and tells the family if nobody answers.
#
# Off by default. Turning something on that talks to a person unprompted should
# be a decision somebody made, not a default they inherited.
#
# ⚠ THE FAMILY IT ESCALATES TO IS `EMERGENCY_CONTACTS`, below. In elder care
# they are almost always the same people, but the two questions are not the same
# one ("who do I call if they fall" is not "who wants to know they skipped a
# tablet"). A deployment needing them separate needs a second list rather than a
# workaround. Reminders still work with no contacts at all; only the escalation
# is off, and the server says so at boot.
#
# ⚠ REQUIRES REDIS TO BE WORTH ANYTHING. Without it the schedules and the
# unanswered reminders are in-process, so a restart forgets both — a dose nobody
# is reminded of and nobody is told about. Logged at ERROR, not WARN.
#
# ⚠ NINE OF ELEVEN LANGUAGES have machine-drafted reminder copy. Same state as
# the rest of src/copy/, and not shippable until a native speaker reviews it.
MEDICATION_ENABLED=false

# The ladder, in minutes. Judgement rather than measurement: ten minutes is
# roughly long enough to walk to the kitchen and back, and nagging sooner is how
# a person learns to ignore the device.
MEDICATION_NUDGE_MINUTES=10
MEDICATION_ESCALATE_MINUTES=20

# When to stop. Two hours late, "take your eight o'clock tablet" is advice
# nobody should act on, and a reminder that never stops gets the device
# unplugged — which silences the alarm path too.
MEDICATION_ABANDON_MINUTES=120

# A cap on how many reminders one person may hold. Not a storage concern: every
# reminder is something the device says out loud unprompted, and a model that
# misreads one sentence as five medications would turn a companion into an alarm
# clock nobody can silence.
MEDICATION_MAX_PER_USER=12

# --- Daily check-in -----------------------------------------------------------
# Say hello once a day, and tell the family if nobody answers at all.
#
# THE SAME MACHINE AS MEDICATION REMINDERS WEARING DIFFERENT COPY, with one real
# difference: a check-in is answered by the person SAYING ANYTHING. There is no
# confirm tool, because "I'm fine", "who is this" and a complaint about the heat
# are the same answer to the only question being asked — is somebody there.
#
# ⚠ IT IS NOT A HEALTH CHECK AND MUST NOT BECOME ONE. Nothing reads what they
# said, scores it, or reports it. The device learns exactly one bit — somebody
# responded — and the family is told only when that bit is missing. Anything
# more is a wellbeing assessment nobody consented to; that is ADR 0009's
# territory and it is off by default for three separate reasons.
#
# ⚠ WHO SETS IT UP IS AN OPEN QUESTION. Today it is the person themselves,
# through the companion, which is backwards for a feature whose point is the
# family's peace of mind. It belongs in the caregiver dashboard, which does not
# exist yet. Until then a caregiver sets it up out loud, next to the person it
# is about — which at least means nobody is watched without knowing.
CHECKIN_ENABLED=false

# A slower ladder than medication, on purpose. A tablet has a window; a person
# who has not spoken yet this morning has not done anything wrong, and twenty
# minutes of quiet is not news.
CHECKIN_NUDGE_MINUTES=20
CHECKIN_ESCALATE_MINUTES=40
CHECKIN_ABANDON_MINUTES=240

# --- Vitals -------------------------------------------------------------------
# Pulse, oxygen, temperature, blood pressure and blood sugar, kept by the safety
# service (elderguard-backend/) rather than here. That service already ingests
# telemetry from the band over MQTT, from a caregiver's CSV upload and from the
# device's own stream, and it checks every reading against its anomaly bands. A
# second store in this process would mean two records of one person's health
# that disagree, and a family reading whichever one their dashboard pointed at.
#
# UNSET MEANS log_vital AND recent_vitals ARE NOT REGISTERED. Both variables are
# required together: a base URL without a key reaches a service that answers 401
# to everything, which is two tools the model offers and cannot use.
#
# WHAT THE COMPANION DOES WITH A READING IS WRITE IT DOWN. It never says whether
# one is high, low, normal or worrying — the only place a vital sign is judged
# is the safety service's bands, and the only thing that follows is the
# escalation ladder asking how the person is, in copy a human reviewed.
VITALS_API_BASE=
# Must equal COMPANION_API_KEY in elderguard-backend/.env.
VITALS_API_KEY=
# One round trip on what should be a local network. Short, because a tool call
# happens inside a turn with somebody waiting.
VITALS_TIMEOUT_MS=4000

# --- Emergency alerting -------------------------------------------------------
# When the user says "help help", "bachao", "I've fallen", "call an ambulance" —
# or when the companion judges from what they are saying that something is
# wrong — this emails the people below.
#
# ⚠ THIS IS NOT AN EMERGENCY SERVICE. It emails people who know the user. It
# cannot call an ambulance, cannot tell whether anyone read the mail, and does
# nothing if the network is down. That is why the SEND RESULT is spoken back to
# the user: a companion that says "I've told them" and has not is worse than one
# with no alarm at all, because it stops them trying anything else.
#
# HOW IT WORKS, and why it is not simply a tool the model calls:
#   1. A local phrase table (src/copy/emergency-intent.ts) is checked FIRST on
#      every final transcript — before the language gate, before the media
#      short-circuit, before any request that can be rate-limited. No LLM round
#      trip, so it cannot be slowed or talked out of firing.
#   2. `raise_alarm` is a tool the model can call for what a phrase table cannot
#      catch — "my chest is hurting", said calmly, in a sentence no list holds.
#
# Name=email pairs, comma-separated. The name is optional and is derived from
# the address when absent (harsh.20224070@... -> "Harsh"). THE NAME IS SPOKEN —
# "I'm telling Harsh and Aman" — because naming someone the user knows is the
# reassurance that helps, where "I have called for help" is vague and alarming.
#
#   EMERGENCY_CONTACTS="Harsh=harsh.20224070@mnnit.ac.in,Aman=aman.20234023@mnnit.ac.in"
EMERGENCY_CONTACTS=

# How long a repeated cry for help folds into the alert already sent. Someone in
# distress says "help" five times in twenty seconds; five emails teach the
# contacts to skim, and a skimmed alert is a missed one. A FAILED send never
# starts this cooldown, so the next cry is not folded into a mail nobody got.
EMERGENCY_COOLDOWN_MS=120000

# --- How the alert leaves: Web API or SMTP ------------------------------------
# WEB API IS PREFERRED FOR THIS PATH, and not as a matter of taste:
#
#   ROUND TRIPS   SMTP is a dozen (EHLO, STARTTLS, EHLO, AUTH, MAIL, one RCPT
#                 per contact, DATA, body, terminator). The API is ONE. On a bad
#                 mobile link that is seconds against tens of seconds, and this
#                 is the one path where slow and failed are the same outcome.
#   REACHABILITY  465/587 are blocked outbound on many campus and hostel
#                 networks. 443 is not blocked anywhere the device could reach
#                 Sarvam from in the first place.
#   DIAGNOSIS     A rejected SMTP login is "535" and a sentence. These return
#                 JSON naming the field that was wrong.
#
# SMTP is NOT deprecated — it is the only way to point at a relay inside India
# (docs/05 Q14 residency), and the only one with no third party at all.
#
# MAIL_TRANSPORT: smtp | sendgrid | resend | brevo
MAIL_TRANSPORT=smtp

# For any transport other than smtp. SENDGRID_API_KEY is accepted as an alias,
# since that is the name in SendGrid's own quickstart.
#   SendGrid: Settings > API Keys > Create. It needs the MAIL SEND permission —
#   a key made with Restricted Access and no scopes ticked returns 401. The key
#   is shown ONCE and cannot be read back.
MAIL_API_KEY=

# ⚠ Must be an address VERIFIED with the provider. All three refuse to send from
# a domain you have not proved you control, and the refusal comes back as a 403
# that reads like an auth error — so it sends people hunting for a bad key.
#   SendGrid: Settings > Sender Authentication > Single Sender Verification
#             (one address), or Domain Authentication (a whole domain).
# Accepts `a@b.com` or `Companion <a@b.com>`. Falls back to SMTP_FROM/SMTP_USER.
MAIL_FROM=

# ⚠ RESIDENCY. SendGrid, Resend and Brevo are US-hosted by default, so the alert
# — which quotes a distressed person verbatim and carries recent conversation —
# leaves India. SendGrid offers an EU data residency option, but no India
# region. Weigh this against docs/05 Q14; SMTP to a domestic relay is the way to
# avoid it entirely. Note the recipients' own mail host may be abroad regardless.

# --- SMTP ---------------------------------------------------------------------
# Any relay. No vendor and no API key, so a deployment can point at a host
# inside India and keep the hop domestic.
#
# SMTP_SECURITY is `tls` (implicit, port 465), `starttls` (587), or `none`
# (a relay on localhost).
#
# GMAIL NEEDS AN APP PASSWORD, not the account password — the account password
# fails with a 535 whose text does not say why. Enable 2-Step Verification, then
# create one at https://myaccount.google.com/apppasswords
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURITY=tls
#   SMTP_USER=your.companion.device@gmail.com
#   SMTP_PASS=<16-character app password, no spaces>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASS=
# Envelope sender. Defaults to SMTP_USER, which is what most relays require.
SMTP_FROM=

# ⚠ HALF-CONFIGURED IS REFUSED, not half-enabled. Contacts with no relay would
# recognise "help" and have nowhere to send it; a relay with no contacts has
# nobody to tell. Either way the companion would say help is coming when nothing
# is, so the server logs an ERROR at boot and leaves the whole path inert.
