# Sarvam credentials
SARVAM_API_KEY=

# --- Endpoint bases -----------------------------------------------------------
# NOTE: these paths come from Sarvam's guide pages. The API-reference pages that
# would confirm exact hostnames returned 404 during research (see
# docs/05-open-questions.md Q12). VERIFY against the dashboard before first run.
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_WS_BASE=wss://api.sarvam.ai

# --- Models -------------------------------------------------------------------
# saaras:v3-realtime is the ONLY model the realtime socket accepts.
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b

# --- Audio --------------------------------------------------------------------
# Sarvam realtime STT accepts ONLY 8000 or 16000. Bulbul streaming caps at 24000.
ASR_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000
DEVICE_FRAME_MS=80

# --- Voice --------------------------------------------------------------------
TTS_SPEAKER=Shubh
TTS_PACE=1.0

# --- Language -----------------------------------------------------------------
# Seed used when a user has no profile and no locale hint.
DEFAULT_SEED_LANGUAGE=hi-IN
# Auto-detect token. Sarvam's docs disagree: "auto" (realtime page) vs "unknown"
# (Saaras page) vs required-explicit (streaming guide). See docs/05 Q1.
# Slice 0 must confirm which of these the socket actually accepts.
ASR_AUTODETECT_TOKEN=unknown

# --- Server -------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
