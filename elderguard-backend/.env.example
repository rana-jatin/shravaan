ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://shravaan:shravaan@db:5432/shravaan
REDIS_URL=redis://redis:6379/0
# Required outside a development ENVIRONMENT. The built-in default is public
# in this repository and signs device tokens that are valid for a year.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
DEVICE_TOKEN_EXPIRE_MINUTES=525600
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Accept an unverified X-User-ID header as proof of identity, instead of a
# bearer token from POST /api/v1/auth/login. For local work only — the service
# REFUSES TO START with this enabled unless ENVIRONMENT is development, dev,
# local or test. It was previously the only user authentication there was.
DEV_TRUSTED_IDENTITY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
TELEMETRY_BATCH_SIZE=100

# Raise an alert row when a stored reading falls outside its band. ON by
# default: the alternative is what this service used to do, which was to store
# vital signs and never look at them. Turn it off for a bench rig or a dataset
# replay, where the alerts would be about nobody.
#
# An alert is NOT emailed. An out-of-range reading is not a confirmed
# emergency, and the companion asks the person before anyone's family is told.
ANOMALY_ALERTS_ENABLED=true
# How long the same kind of alert folds into the one already raised. A pulse
# still out of range a quarter of an hour later is a new event; the same pulse
# in six consecutive readings is not six of them.
ANOMALY_COOLDOWN_MINUTES=15

# Shared secret the voice companion presents on /api/v1/companion/*, as
# X-Companion-Key. Must match COMPANION_API_KEY in the companion's own .env.
#
# A key rather than a JWT because of what the caller is: a device token names
# one device and a user token names one person, and the companion acts for
# whoever is currently talking to it. UNSET MEANS THOSE ROUTES REFUSE with a
# 503 naming this variable — never that they are open.
COMPANION_API_KEY=
MQTT_ENABLED=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=shravaan/devices/+/telemetry
RELATIVE_EMAILS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
