{
  "name": "sp-i",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multilingual companion voice agent — Sarvam ASR/LLM/TTS, device client, roll-your-own orchestrator",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "node --experimental-strip-types --env-file=.env src/server.ts",
    "start": "node --experimental-strip-types --env-file=.env src/server.ts",
    "device": "node --experimental-strip-types --env-file=.env scripts/device-client.ts",
    "render:holding": "node --experimental-strip-types --env-file=.env scripts/render-holding-audio.ts",
    "verify:tools": "node --experimental-strip-types --env-file=.env scripts/verify-tool-calling.ts",
    "verify:alert": "node --experimental-strip-types --env-file=.env scripts/verify-alert.ts",
    "verify:care": "node --experimental-strip-types --env-file=.env scripts/verify-care-signals.ts",
    "verify:asr": "node --experimental-strip-types --env-file=.env scripts/verify-asr.ts"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
