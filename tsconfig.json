{
  // Solution-style root: each workspace package owns its own tsconfig.json
  // (extending tsconfig.base.json) and is typechecked independently via
  // `tsc -p <package> --noEmit`. This file exists so editors opening a file
  // outside any package still get sane compiler options; it has nothing to
  // include on its own.
  "extends": "./tsconfig.base.json",
  "include": []
}
